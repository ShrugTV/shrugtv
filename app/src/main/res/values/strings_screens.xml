    <string name="settings_show_advanced">Show advanced settings</string>
    <string name="settings_show_advanced_summary">Shows the rarely needed settings (timings, 7TV details, MQTT topics, notification looks) and the page "Advanced". Nothing is switched off by hiding it.</string>
    <string name="settings_home_tip">Home covers what you see first: which rows show on the home screen, the language row, what to hide, how often it refreshes and the size of the cards. The preview on the right shows cards and start screen. Start: under "Start" you choose the splash and whether ShrugTV opens the last channel.</string>
    <string name="settings_quality_tip">The default quality for live streams and for recordings (VODs), low latency and frame-rate matching. In the player, the Quality button changes it for the stream you are watching.</string>
    <string name="settings_live_tip">What the player does with a live stream: the Back to live button, rewinding the live stream, restarting a stalled stream by itself, the replay button and what happens when a stream ends or a raid starts.</string>
    <string name="pref_title_row_order">Row order</string>
    <string name="settings_row_order_tip">Press OK on a row to move it up one place; the first row goes to the end. The home screen shows the rows in this order. Which rows show is set one page up.</string>
    <string name="settings_row_order_reset">Back to the built-in order</string>
    <string name="settings_row_place">Place %1$d</string>
    <string name="settings_row_order_reset_done">Row order reset</string>
    <string name="settings_pref_filter_commands">Hide chat commands</string>
    <string name="settings_pref_filter_commands_summary">Hides messages that start with \"!\" (!lurk, !discord) without also hiding known bots</string>
    <string name="settings_chat_text_shadow">Text shadow</string>
    <string name="settings_chat_text_shadow_summary">A dark edge around chat text so it stays readable on any picture</string>
    <string name="settings_quiet_category">Quiet hours</string>
    <string name="settings_quiet_tip">No \"is live\" notices between the two times (also over midnight, e.g. 22:00 to 07:00). Home Assistant still gets the events. Equal times mean the whole day.</string>
    <string name="settings_quiet_on">Quiet hours</string>
