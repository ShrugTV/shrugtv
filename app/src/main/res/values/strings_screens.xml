    <string name="settings_quiet_to">Until</string>
    <string name="settings_update_check">Check for updates</string>
    <string name="settings_update_check_summary">Once a day the app asks the ShrugTV release page on GitHub whether a newer version exists and tells you. Without the next setting it downloads and installs nothing; GitHub sees your IP address. Off by default.</string>
    <string name="settings_update_check_now">Check now</string>
    <string name="settings_update_check_now_summary">Asks right away, ignoring the daily limit</string>
