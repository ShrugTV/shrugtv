<?xml version="1.0" encoding="utf-8"?>
<!-- From Android 12 (dataExtractionRules): like backup_rules.xml, for cloud backup and
          device transfer. After a transfer one signs in again ( point 3). -->
<data-extraction-rules>
    <cloud-backup>
        <exclude domain="sharedpref" path="User.xml" />
        <exclude domain="sharedpref" path="Mqtt.xml" />
        <exclude domain="sharedpref" path="CompanionDevices.xml" />
        <exclude domain="database" path="watch_stats" />
        <exclude domain="database" path="watch_stats-journal" />
        <exclude domain="database" path="watch_stats-wal" />
        <exclude domain="database" path="watch_stats-shm" />
    </cloud-backup>
    <device-transfer>
        <exclude domain="sharedpref" path="User.xml" />
        <exclude domain="sharedpref" path="Mqtt.xml" />
        <exclude domain="sharedpref" path="CompanionDevices.xml" />
        <exclude domain="database" path="watch_stats" />
        <exclude domain="database" path="watch_stats-journal" />
        <exclude domain="database" path="watch_stats-wal" />
        <exclude domain="database" path="watch_stats-shm" />
    </device-transfer>
</data-extraction-rules>
