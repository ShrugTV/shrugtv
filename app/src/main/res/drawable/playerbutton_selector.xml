<?xml version="1.0" encoding="utf-8"?>
<!-- Round buttons of the player bar: glass circle, white in focus; before a purple square -->
<selector android:enterFadeDuration="@integer/playbutton_enter_in_duration" android:exitFadeDuration="@integer/playbutton_exit_out_duration"
  xmlns:android="http://schemas.android.com/apk/res/android">
    <item android:state_pressed="true" android:drawable="@drawable/playerbutton_round_focus" />
    <item android:state_focused="true" android:drawable="@drawable/playerbutton_round_focus" />
    <item android:drawable="@drawable/playerbutton_round" />
</selector>
