<?xml version="1.0" encoding="utf-8"?>
<!-- Input bar in the player, used for "Send message" and for search: round
     dark bar in Inter, with a magnifier for search (TV_SearchText), a key hint on the right.
     Before: a square field with a "Search:" label or an empty field with a purple frame. -->
<LinearLayout android:orientation="horizontal" android:gravity="center_vertical" android:background="@drawable/input_bar"
    android:layout_width="wrap_content" android:layout_height="wrap_content" android:minHeight="52dp"
    android:paddingStart="20dp" android:paddingEnd="10dp"
  xmlns:android="http://schemas.android.com/apk/res/android">
    <TextView android:id="@id/TV_SearchText" android:visibility="gone" android:layout_width="wrap_content" android:layout_height="wrap_content"
        android:drawableStart="@drawable/ic_search" android:layout_marginEnd="12dp" android:text="" />
    <EditText android:id="@id/ET_SendMessage" android:layout_width="440dp" android:layout_height="wrap_content"
        android:background="@null" android:padding="0dp" android:textColor="@color/white" android:textColorHint="#FF8C8C99"
        android:textSize="16sp" android:fontFamily="@font/inter_regular" android:text="" android:inputType="text" android:maxLines="1"
        android:textCursorDrawable="@null" />
    <TextView android:id="@+id/InputKey" style="@style/AdjustKey" android:layout_marginStart="12dp" android:text="OK" />
    <TextView android:id="@+id/InputAction" style="@style/AdjustText" android:layout_marginEnd="6dp" android:text="@string/input_send" />
</LinearLayout>
