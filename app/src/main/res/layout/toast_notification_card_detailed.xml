<?xml version="1.0" encoding="utf-8"?>
<!-- Notice with avatar (e.g. "<channel> is live") as a glass card: round avatar,
     bold title, one grey line below. Before: CardView with a square avatar and up to 4 lines. -->
<LinearLayout android:id="@id/ToastCard" android:background="@drawable/notice_card" android:orientation="horizontal" android:gravity="center_vertical"
    android:layout_width="wrap_content" android:layout_height="wrap_content"
    android:paddingStart="14dp" android:paddingEnd="18dp" android:paddingTop="12dp" android:paddingBottom="12dp"
  xmlns:android="http://schemas.android.com/apk/res/android">
    <ImageView android:id="@id/BadgeImage" android:layout_width="44dp" android:layout_height="44dp" android:layout_marginEnd="12dp" />
    <LinearLayout android:orientation="vertical" android:layout_width="wrap_content" android:layout_height="wrap_content">
        <TextView android:id="@id/notification_text" android:textColor="@color/white" android:fontFamily="@font/inter_bold"
            android:layout_width="wrap_content" android:layout_height="wrap_content" android:maxWidth="320dp" android:maxLines="1" android:ellipsize="end" />
        <TextView android:id="@id/channelTitle" android:textSize="12sp" android:textColor="#FFADADB8" android:fontFamily="@font/inter_regular"
            android:layout_width="wrap_content" android:layout_height="wrap_content" android:layout_marginTop="2dp" android:maxWidth="320dp" android:maxLines="1" android:ellipsize="end" />
    </LinearLayout>
</LinearLayout>
